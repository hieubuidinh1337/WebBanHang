@page
@model LoginModel
@{
    ViewData["Title"] = "Đăng nhập";
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=DM+Sans:wght@300;400;500&display=swap');

    :root {
        --ink:     #1a1a2e;
        --surface: #f8f5f0;
        --card:    #ffffff;
        --gold:    #c9a84c;
        --gold-lt: #f0e0b0;
        --muted:   #7a7a8c;
        --danger:  #c0392b;
        --radius:  12px;
        --shadow:  0 4px 24px rgba(26,26,46,.08);
    }

    body { background: var(--surface); font-family: 'DM Sans', sans-serif; color: var(--ink); }

    .auth-wrapper {
        min-height: 80vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem 1rem;
    }

    .auth-card {
        background: var(--card);
        border-radius: var(--radius);
        box-shadow: var(--shadow);
        border: 1px solid #ede8e2;
        width: 100%;
        max-width: 440px;
        padding: 2.5rem 2.75rem;
    }

    .auth-logo {
        text-align: center;
        margin-bottom: 1.75rem;
    }
    .auth-logo-icon {
        width: 54px; height: 54px;
        background: var(--ink);
        border-radius: 14px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin-bottom: .75rem;
    }
    .auth-logo-icon svg { width: 28px; height: 28px; stroke: var(--gold); }

    .auth-title {
        font-family: 'Playfair Display', serif;
        font-size: 1.65rem;
        font-weight: 700;
        color: var(--ink);
        text-align: center;
        margin-bottom: .35rem;
        letter-spacing: -.02em;
    }
    .auth-title span { color: var(--gold); }

    .auth-subtitle {
        text-align: center;
        font-size: .85rem;
        color: var(--muted);
        margin-bottom: 1.75rem;
    }

    .divider {
        border: none;
        border-top: 1px solid #ede8e2;
        margin: 1.5rem 0;
    }

    /* Floating label group */
    .field-group {
        position: relative;
        margin-bottom: 1.25rem;
    }
    .field-group label {
        position: absolute;
        top: 50%;
        left: 1rem;
        transform: translateY(-50%);
        font-size: .875rem;
        color: var(--muted);
        pointer-events: none;
        transition: all .18s ease;
        background: var(--card);
        padding: 0 .25rem;
    }
    .field-group input:focus + label,
    .field-group input:not(:placeholder-shown) + label {
        top: 0;
        font-size: .72rem;
        color: var(--gold);
        transform: translateY(-50%);
    }
    .field-group input {
        width: 100%;
        padding: .85rem 1rem;
        border: 1.5px solid #e4ddd4;
        border-radius: 8px;
        font-size: .9rem;
        font-family: 'DM Sans', sans-serif;
        color: var(--ink);
        background: var(--card);
        transition: border-color .18s;
        outline: none;
        box-sizing: border-box;
    }
    .field-group input:focus {
        border-color: var(--gold);
        box-shadow: 0 0 0 3px rgba(201,168,76,.12);
    }
    .field-group .text-danger {
        font-size: .75rem;
        margin-top: .3rem;
        display: block;
        color: var(--danger);
    }

    /* Remember me */
    .remember-row {
        display: flex;
        align-items: center;
        gap: .5rem;
        margin-bottom: 1.5rem;
        font-size: .85rem;
        color: var(--muted);
    }
    .remember-row input[type="checkbox"] {
        accent-color: var(--gold);
        width: 16px; height: 16px;
        cursor: pointer;
    }

    /* Validation summary */
    .validation-summary-errors {
        background: #fdf0ef;
        border: 1px solid #f5c2be;
        border-radius: 8px;
        padding: .75rem 1rem;
        margin-bottom: 1.25rem;
        font-size: .83rem;
        color: var(--danger);
    }
    .validation-summary-errors ul { margin: 0; padding-left: 1.2rem; }

    /* Buttons */
    .btn-primary-auth {
        width: 100%;
        padding: .85rem;
        background: var(--ink);
        color: #fff;
        border: none;
        border-radius: 50px;
        font-size: .925rem;
        font-weight: 500;
        font-family: 'DM Sans', sans-serif;
        cursor: pointer;
        letter-spacing: .03em;
        transition: background .2s, transform .15s;
        margin-bottom: 1.25rem;
    }
    .btn-primary-auth:hover { background: var(--gold); color: var(--ink); transform: translateY(-1px); }

    /* Links */
    .auth-links {
        display: flex;
        flex-direction: column;
        gap: .45rem;
        text-align: center;
    }
    .auth-links a {
        font-size: .83rem;
        color: var(--muted);
        text-decoration: none;
        transition: color .15s;
    }
    .auth-links a:hover { color: var(--gold); }
    .auth-links .link-register {
        font-weight: 500;
        color: var(--ink);
    }
    .auth-links .link-register:hover { color: var(--gold); }
</style>

<div class="auth-wrapper">
    <div class="auth-card">

        <div class="auth-logo">
            <div class="auth-logo-icon">
                <svg fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round"
                          d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                </svg>
            </div>
        </div>

        <h1 class="auth-title">Chào mừng <span>trở lại</span></h1>
        <p class="auth-subtitle">Đăng nhập để quản lý cửa hàng của bạn</p>

        <form id="account" method="post">
            <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

            <div class="field-group">
                <input asp-for="Input.Email"
                       autocomplete="username"
                       aria-required="true"
                       placeholder=" " />
                <label asp-for="Input.Email">Email</label>
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            <div class="field-group">
                <input asp-for="Input.Password"
                       autocomplete="current-password"
                       aria-required="true"
                       placeholder=" " />
                <label asp-for="Input.Password">Mật khẩu</label>
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>

            <div class="remember-row">
                <input class="form-check-input" asp-for="Input.RememberMe" />
                <label asp-for="Input.RememberMe">@Html.DisplayNameFor(m => m.Input.RememberMe)</label>
            </div>

            <button id="login-submit" type="submit" class="btn-primary-auth">
                Đăng nhập
            </button>
        </form>

        <hr class="divider" />

        <div class="auth-links">
            <a id="forgot-password" asp-page="./ForgotPassword">Quên mật khẩu?</a>
            <a class="link-register" asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">
                Chưa có tài khoản? Đăng ký ngay
            </a>
            <a id="resend-confirmation" asp-page="./ResendEmailConfirmation">Gửi lại email xác nhận</a>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
